{
	"schemaVersion": 1,
	"id": "carpet-acmax",
	"version": "${version}",
	"name": "Carpet ACMAX addition",
	"description": "Carpet extension that adds end gateway cooldown toggle.",
	"authors": [
		"Gufeng"
	],
	"contact": {
		"homepage": "https://github.com/Gufeng/carpet-acmax",
		"sources": "https://github.com/Gufeng/carpet-acmax"
	},
	"license": "MIT",
	"icon": "assets/carpet-acmax/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.gufeng.CarpetACMAX"
		],
		"client": [
			"com.gufeng.client.CarpetACMAXClient"
		],
		"fabric-datagen": [
			"com.gufeng.client.CarpetACMAXDataGenerator"
		]
	},
	"mixins": [
		"carpet-acmax.mixins.json",
		{
			"config": "carpet-acmax.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.15.0",
		"minecraft": ">=26.2",
		"java": ">=25",
		"fabric-api": "*",
		"carpet": "*"
	}
}
